# ─────────────────────────────────────────────────────────────
# Davochain backend — environment
#
# Copy to .env and fill in. Startup FAILS LOUDLY on anything
# missing or malformed — see src/config/env.validation.ts.
#
# There is no Quidax sandbox. QUIDAX_SECRET_KEY controls the
# entire treasury. Never commit it, never put it on a laptop,
# never let a dev process hold the production value.
# ─────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════
# GOING LIVE — the settings that must change from these defaults
#
# Everything below this block has a default that is right for a
# laptop and wrong for production. These are the ones to check.
# Each is explained where it appears further down.
#
# REFUSES TO BOOT if wrong:
#   NODE_ENV=production
#   QUIDAX_USE_MOCK=false      real money; the mock is rejected
#   QUIDAX_SECRET_KEY=         required once the mock is off
#   QUIDAX_WEBHOOK_SECRET=     required once the mock is off,
#                              and must match the Signature
#                              Secret set on the Quidax dashboard
#
# WARNS AT STARTUP if missing — the process runs, but something
# is switched off:
#   CREDENTIALS_KEY=           without it, gift card voucher
#                              codes are refused and stored
#                              provider credentials are plaintext
#   CORS_ORIGINS=              empty means no browser front end
#                              may call the API (app + dashboard
#                              are unaffected)
#
# SILENT IF WRONG — nothing complains, it just does not work:
#   PUBLIC_API_URL=            left on localhost, the phone asks
#                              itself for brand logos and social
#                              icons, and emails show no images
#   ADMIN_URL=                 admin invitation links point at
#                              localhost and cannot be opened
#   FCM_*                      all three or none; push is simply
#                              off without them, iOS additionally
#                              needs the APNs key uploaded to
#                              Firebase or it is silent with no
#                              error anywhere
#   SMTP_*                     no admin alerts, no admin
#                              password-reset codes
#   ENABLE_DOCS=false          leave false; /docs enumerates
#                              every route and schema
#
# ALSO NOT IN THIS FILE, but required before real money moves:
#   • The Quidax dashboard's Callback URL must be
#     https://<your host>/webhooks/quidax   — note the "s", and
#     no /v1 prefix. Any other spelling 404s and the event is
#     retried five times and then lost forever.
#   • Its Signature Type must be "HMAC Encoded Signature".
#     Blank means unsigned, and unsigned events are rejected.
# ═════════════════════════════════════════════════════════════

NODE_ENV=development
# Browsable API docs at /docs. On by default outside production, since they
# enumerate every route and schema. Set true to force them on in production.
ENABLE_DOCS=false
PORT=3000
API_PREFIX=v1

# ── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://davochain:davochain@localhost:5432/davochain?schema=public"

# ── Redis (BullMQ queues) ───────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Quidax ──────────────────────────────────────────────────
# Dashboard → your username → API management → Create.
# See README "Getting your Quidax key".
QUIDAX_BASE_URL=https://openapi.quidax.io/exchange-open-api/api/v1
QUIDAX_SECRET_KEY=

# Webhook signature secret — set the SAME value in the Quidax
# dashboard under API Management → Webhook Configuration.
QUIDAX_WEBHOOK_SECRET=

# Reject webhooks with a timestamp older than this (replay window).
QUIDAX_WEBHOOK_TOLERANCE_SECONDS=300

# Shared budget across prod, staging, admin and any dev process
# pointed at the live key. Quidax allows 300/min; stay under it.
QUIDAX_RATE_LIMIT_PER_MINUTE=240
# Address creation is capped at 20/sec upstream.
QUIDAX_ADDRESS_RATE_LIMIT_PER_SECOND=15
# Background work (fee claims, syncs) gets its own small lane so
# it can never starve live trading.
QUIDAX_BACKGROUND_RATE_LIMIT_PER_MINUTE=30

# Point every non-production process at the mock instead.
# There is no sandbox — this is how you develop without moving money.
QUIDAX_USE_MOCK=true

# ── Pricing ─────────────────────────────────────────────────
# How long a quote shown to a user stays valid. The Continue
# button fades when it expires.
QUOTE_TTL_SECONDS=12
# Server-side coalescing cache for the upstream rate. Keeps a
# thousand users watching BTC down to ~20 calls a minute.
RATE_CACHE_TTL_SECONDS=3
# Refuse to execute a quote older than this, even if presented.
QUOTE_HARD_EXPIRY_SECONDS=30

# ── Identity ────────────────────────────────────────────────
# Quidax sub-account emails are unique and IMMUTABLE, and there is
# no delete endpoint — every signup permanently burns an address on
# the live merchant account. Test accounts MUST use the test domain
# so they can be filtered out of every report you will ever write.
USER_ALIAS_EMAIL_DOMAIN=users.davochain.com
TEST_ALIAS_EMAIL_DOMAIN=test.davochain.com

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=8h
# Minutes of inactivity before an admin session ends. Guards a dashboard left
# open on an unlocked machine, so the clock runs on idleness, not token age.
ADMIN_IDLE_TIMEOUT_MINUTES=30

# Encrypts partner API keys stored from the admin panel (System -> API keys).
# Must NOT be kept in the database this protects. Losing it makes every stored
# credential unreadable; the env vars below still work as the fallback.
#   openssl rand -base64 48
CREDENTIALS_KEY=

# ── Push notifications (Firebase Cloud Messaging) ───────────
# ALL THREE OR NONE — the app refuses to boot on a partial set,
# because two out of three looks configured and sends nothing.
# Without these, push is off and notifications are still stored
# and readable at GET /v1/notifications.
#
# From the Firebase service account JSON:
#   Project settings -> Service accounts -> Generate new private key
# Full walkthrough: docs/PUSH.md
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Keep the literal 
 sequences from the JSON and wrap in double
# quotes. Real newlines will not parse. This is the single most
# common reason FCM setup fails.
FCM_PRIVATE_KEY=

# ── Where things live, for links we hand to other people ────
# A logo referenced as a path resolves against the mail provider, not us,
# so emails need absolute URLs. The same address is handed to the phone as
# the gift card brand logos and the social icons, so if this is left at
# localhost in production the app asks itself for them and shows nothing.
# ADMIN_URL is where an invited admin lands.
PUBLIC_API_URL=http://localhost:3000
ADMIN_URL=http://localhost:3100
ADMIN_INVITE_TTL_HOURS=48

# Which websites may call this API from inside a browser. Comma-separated,
# full origins with the scheme, no trailing slash:
#   CORS_ORIGINS=https://admin.davochain.com,https://davochain.com
#
# This is a BROWSER rule only. The mobile app is unaffected — CORS does not
# apply to it — and the admin dashboard calls the API from its own server, so
# it is unaffected too. Empty in production means no website may call it from
# a browser, which is safe because nothing does today. Empty in development
# means anything may, so a local page on any port works.
CORS_ORIGINS=

# ── SMTP (admin alerts, and admin password-reset codes) ─────
# Without SMTP_HOST no reset code can be delivered. Outside production the API
# logs the code so a reset is still testable; in production it does not.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Davochain <alerts@davochain.com>"
# Comma-separated. Overridable per alert type in alert_recipients.
ALERT_DEFAULT_RECIPIENTS=
# Fixed daily send. Its ABSENCE is your mailer health check:
# no digest in the morning means the alert channel is down.
DAILY_DIGEST_HOUR=7
DIGEST_TIMEZONE=Africa/Lagos

# ── Treasury ────────────────────────────────────────────────
# Where claimed swap fees land.
FEE_CLAIM_DESTINATION=usdt
# Fee revenue is denominated in USD but held in coin until claimed.
# Claim regularly or it drifts with the market.
FEE_CLAIM_MIN_USD=1.5

# ── Safety rails (§3) ───────────────────────────────────────
# Ship with the brakes on. Raise deliberately once the numbers
# reconcile for a week.
TRADING_ENABLED=true
MAX_TRADE_USD=2000
MAX_USER_DAILY_USD=5000
MAX_PLATFORM_DAILY_USD=50000
# Pause an asset if realised margin deviates from expected by more
# than this. A rate bug shows up here on trade one.
MARGIN_DEVIATION_TRIP_BPS=200
